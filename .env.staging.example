## Staging Environment Configuration Template
## Copy this file to .env.staging and fill in your values
## For deployment to Docker Swarm with Traefik
## DO NOT use quotes around values

## ## ## ## ## ## ## ## ## ##
# Hubzilla/Site config      #
#
#   NOTES:
# DOMAIN: Your staging domain (e.g., hubzilla.staging.yourdomain.com)
# ADMIN_EMAIL: Admin email address for the site
# TIMEZONE: Server timezone (see https://www.php.net/manual/en/timezones.php)
# REGISTER_POLICY: REGISTER_OPEN, REGISTER_APPROVE, or REGISTER_CLOSED

DOMAIN=your-subdomain.staging.yourdomain.com
ADMIN_EMAIL=admin@staging.yourdomain.com
TIMEZONE=America/New_York
REQUIRE_EMAIL=1
REGISTER_POLICY=REGISTER_APPROVE
ADDON_LIST=logrot nsfw superblock diaspora pubcrawl

## ## ## ## ## ## ## ## ## ##
# Database config           #
# 
#   NOTES:
# DB_HOST: Must match service name in docker-stack.yml (usually hub_db)
# DB_PASSWORD: Use a strong random password
# POSTGRES_PASSWORD: Must match DB_PASSWORD

DB_HOST=hub_db
DB_NAME=hub
DB_USER=hubzilla
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

DB_TYPE=postgres
DB_PORT=5432

# PostgreSQL Docker container environment variables
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
POSTGRES_USER=hubzilla
POSTGRES_DB=hub

## ## ## ## ## ## ## ## ## ##
# SMTP Config               #
#
#   NOTES:
# SMTP_HOST: Must match stalwart service name in docker-stack.yml
# SMTP_DOMAIN: Base domain for email (e.g., staging.yourdomain.com)
# SMTP_USER: Admin email for SMTP authentication
# SMTP_PASS: Strong password for SMTP admin user
# STALWART_ADMIN_PASSWORD: Must match SMTP_PASS

SMTP_HOST=stalwart
SMTP_PORT=587
SMTP_DOMAIN=staging.yourdomain.com
SMTP_USER=admin@staging.yourdomain.com
SMTP_PASS=YOUR_STRONG_SMTP_PASSWORD_HERE
SMTP_USE_STARTTLS=YES

# Stalwart Mail Server Configuration
STALWART_ADMIN_PASSWORD=YOUR_STRONG_SMTP_PASSWORD_HERE

# Python Email Processing Settings
IMAP_HOST=mail.staging.yourdomain.com
IMAP_PORT=143
IMAP_USE_SSL=false
IMAP_FOLDER=INBOX
IMAP_MARK_READ=false
DEBUG=false
LOG_LEVEL=INFO

# CalDAV Configuration
CALDAV_BASE_URL=https://your-subdomain.staging.yourdomain.com/cdav/

# Email to Channel Routing (format: email:channel|email:channel)
# Update email addresses to match your SMTP_DOMAIN
EMAIL_CHANNEL_MAPPING=tech@staging.yourdomain.com:tech|music@staging.yourdomain.com:music|education@staging.yourdomain.com:education|volunteer@staging.yourdomain.com:volunteer|community@staging.yourdomain.com:community|admin@staging.yourdomain.com:admin

# Docker Service Names (must match service names in docker-stack.yml)
WEBSERVER_SERVICE_NAME=hub

## ## ## ## ## ## ## ## ## ##
# Logging                   #
#
#   NOTES:
# LOGROT_SIZE: Size in bytes (10485760 = 10MB)

ENABLE_LOGROT=1
LOGROT_PATH=log
LOGROT_SIZE=10485760
LOGROT_MAXFILES=10

## ## ## ## ## ## ## ## ## ##
# Debug                     #
DEBUG_PHP=0
