## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ##
##  STAGING/PRODUCTION DEPLOYMENT                            ##
##  Passwords MUST be stored in Docker Secrets (see below)   ##
## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ##
## DO NOT use quotes around values

## ## ## ## ## ## ## ## ## ##
# Hubzilla/Site config      #
DOMAIN=hubzilla.staging.chattanooga.digital
ADMIN_EMAIL=admin@chattanooga.digital
TIMEZONE=America/New_York
REQUIRE_EMAIL=1
REGISTER_POLICY=REGISTER_APPROVE
ADDON_LIST=logrot nsfw superblock diaspora pubcrawl

## ## ## ## ## ## ## ## ## ##
# Database config           #
DB_HOST=hub_db
DB_NAME=hub
DB_USER=hubzilla
DB_TYPE=postgres
DB_PORT=5432

## ## ## ## ## ## ## ## ## ##
# SMTP Config               #
SMTP_HOST=mail_stalwart
SMTP_PORT=587
SMTP_DOMAIN=staging.chattanooga.digital
SMTP_USER=admin@chattanooga.digital
SMTP_USE_STARTTLS=YES

# Mail Server Configuration
MAIL_DOMAIN=mail.staging.chattanooga.digital

# Python Email Processing Settings
IMAP_HOST=mail.staging.chattanooga.digital
IMAP_PORT=143
IMAP_USE_SSL=false
IMAP_FOLDER=INBOX
IMAP_MARK_READ=false
DEBUG=false
LOG_LEVEL=INFO

# CalDAV Configuration
CALDAV_BASE_URL=https://hubzilla.staging.chattanooga.digital/cdav/

# Email to Channel Routing
EMAIL_CHANNEL_MAPPING=tech@chattanooga.digital:tech|music@chattanooga.digital:music|education@chattanooga.digital:education|volunteer@chattanooga.digital:volunteer|community@chattanooga.digital:community|admin@chattanooga.digital:admin

# Docker Service Names
WEBSERVER_SERVICE_NAME=hub

## ## ## ## ## ## ## ## ## ##
# Logging                   #
ENABLE_LOGROT=1
LOGROT_PATH=log
LOGROT_SIZE=10485760
LOGROT_MAXFILES=10

## ## ## ## ## ## ## ## ## ##
# Debug                     #
DEBUG_PHP=0

## ## ## ## ## ## ## ## ## ##
# PASSWORDS ARE MANAGED VIA DOCKER SECRETS
# Create secrets on server with:
#   echo "your_password" | docker secret create hubzilla_db_password -
#   echo "your_password" | docker secret create hubzilla_smtp_password -
#   echo "your_password" | docker secret create hubzilla_stalwart_admin_password -
